build:gcc --extra_toolchains=@gcc_toolchain_x86_64//:cc_toolchain
build:gcc --cxxopt=-std=c++20
build:gcc --compilation_mode=opt
build:gcc --copt=-O2
build:gcc --copt=-DNDEBUG
build:gcc --linkopt=-lstdc++

build:gcc_dbg --config=gcc
build:gcc_dbg --compilation_mode=dbg
build:gcc_dbg --copt=-O0
build:gcc_dbg --copt=-g3
build:gcc_dbg --copt=-UNDEBUG

build:clang_tidy --aspects @bazel_clang_tidy//clang_tidy:clang_tidy.bzl%clang_tidy_aspect
build:clang_tidy --output_groups=report
build:clang_tidy --@bazel_clang_tidy//:clang_tidy_config=//:clang_tidy_config
build:clang_tidy --@bazel_clang_tidy//:clang_tidy_executable=//tools:clang_tidy

build:clang_tidy_pedantic --config=clang_tidy
build:clang_tidy_pedantic --@bazel_clang_tidy//:clang_tidy_config=//:clang_tidy_pedantic_config

build:gcc_tools --config=gcc
